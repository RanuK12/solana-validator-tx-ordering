{
  "name": "solana-validator-tx-ordering",
  "version": "1.0.0",
  "description": "Empirical investigation and reproducible measurement pipeline for Solana Mainnet validator intra-block transaction ordering across client forks (Post-Alpenglow Epoch 1075).",
  "type": "module",
  "scripts": {
    "start": "node src/cli.mjs --dry-run",
    "dry-run": "node src/cli.mjs --dry-run",
    "live": "node src/cli.mjs --live --max-spend-sol 0.05",
    "collect-mainnet": "node src/collect_mainnet_blocks.mjs",
    "verify": "node src/verify_claims.mjs",
    "analyze": "node src/analyze_ordering.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "solana",
    "validators",
    "agave",
    "firedancer",
    "frankendancer",
    "jito",
    "transaction-ordering",
    "scheduler",
    "alpenglow"
  ],
  "author": "chusmias258-dev",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
